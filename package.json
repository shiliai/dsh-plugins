{
  "name": "dsh-plugins",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --recursive --if-present run test",
    "versions:check": "node scripts/verify-plugin-versions.mjs",
    "update:smoke": "node scripts/verify-dsh-git-update.mjs",
    "bootstrap": "node scripts/dsh-bootstrap/bootstrap.mjs",
    "bootstrap:check": "node scripts/dsh-bootstrap/bootstrap.mjs check",
    "updater:pack:check": "pnpm --dir scripts/dsh-plugin-updater pack --dry-run",
    "check": "pnpm versions:check && pnpm --recursive --if-present run check",
    "pack:check": "pnpm --recursive --if-present run pack:check && pnpm updater:pack:check",
    "release:check": "pnpm --recursive --if-present run release:check"
  }
}
