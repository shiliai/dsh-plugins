# dsh-reading 配置模板 —— 复制为 ~/.dsh/reading/.env 或部署环境的 .env 后填写
# 所有变量均为可选；未配置的源在 UI 中显示"未配置"并禁用对应功能。
# 多主机部署：每台机器各配一份，变量名不变。

# ---------- 数据 ----------
# 导入文件、转换缓存、阅读进度/批注状态库的存放目录
DSH_READING_DATA_DIR=~/.dsh/reading

# ---------- OPDS 书源（可配置多个，n = 0,1,2...） ----------
# nasubuntu · calibre-web（局域网地址，按实际部署修改）
DSH_READING_OPDS_0_NAME=nasubuntu-calibre
DSH_READING_OPDS_0_URL=http://192.168.88.22:9080/opds
DSH_READING_OPDS_0_AUTH=basic
DSH_READING_OPDS_0_USERNAME=
DSH_READING_OPDS_0_PASSWORD=

# 备选：Talebook OPDS
# DSH_READING_OPDS_1_NAME=nasubuntu-talebook
# DSH_READING_OPDS_1_URL=http://192.168.88.22:9088/opds
# DSH_READING_OPDS_1_AUTH=bearer
# DSH_READING_OPDS_1_TOKEN=

# ---------- Wallabag（URL 收藏 / 稍后读 / 正文提取） ----------
DSH_READING_WALLABAG_URL=http://192.168.88.22:8292
DSH_READING_WALLABAG_CLIENT_ID=
DSH_READING_WALLABAG_CLIENT_SECRET=
DSH_READING_WALLABAG_USERNAME=
DSH_READING_WALLABAG_PASSWORD=

# ---------- Amazon 格式转换（SSH 到 calibre 主机执行 ebook-convert） ----------
# 留空则禁用 AZW3/MOBI/AZW 转换（这些格式显示"未配置转换主机"）
DSH_READING_CONVERT_SSH_TARGET=nasubuntu
DSH_READING_CONVERT_REMOTE_TMPDIR=/tmp/dsh-reading

# ---------- Obsidian 导出 ----------
# 笔记写入 vault 内的子目录（vault 根目录由 dsh-obsidian 插件配置决定）
DSH_READING_OBSIDIAN_EXPORT_DIR=读书笔记

# ---------- URL 抓取 ----------
DSH_READING_FETCH_TIMEOUT_MS=20000
# DSH_READING_FETCH_USER_AGENT=
