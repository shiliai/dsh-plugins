# dsh-reading 配置模板 —— 非密钥部分
# 用法：复制为 $DSH_HOME/.env（本机即 ~/.local/dsh_home/.env）
# 密钥（*_PASSWORD / *_SECRET / *_TOKEN）不放在这里，
# 写入 $DSH_HOME/.credentials.yaml 的顶层 flat mapping，键名与变量名相同，例如：
#   READING_OPDS_0_PASSWORD: "xxxx"
#   READING_WALLABAG_CLIENT_SECRET: "xxxx"
# 插件解析顺序：进程环境 > credentials flat mapping > $DSH_HOME/.env
# 多主机部署：每台机器各配一份，变量名不变。

# ---------- 数据 ----------
READING_DATA_DIR=~/.local/dsh_home/reading

# ---------- OPDS 书源（可配置多个，n = 0,1,2...） ----------
# 注意：calibre-web 须直连后端端口（本例 9083），9080 前端的 nginx 会剥掉 Authorization
READING_OPDS_0_NAME=nasubuntu-calibre
READING_OPDS_0_URL=http://192.168.88.22:9083/opds
READING_OPDS_0_AUTH=basic
READING_OPDS_0_USERNAME=dshreading
# READING_OPDS_0_PASSWORD  → .credentials.yaml

# ---------- Wallabag（URL 收藏 / 稍后读 / 正文提取） ----------
READING_WALLABAG_URL=http://192.168.88.22:8292
READING_WALLABAG_CLIENT_ID=6_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# READING_WALLABAG_CLIENT_SECRET / _USERNAME / _PASSWORD → .credentials.yaml

# ---------- Amazon 格式转换（SSH 到 calibre 主机执行 ebook-convert） ----------
READING_CONVERT_SSH_TARGET=nasubuntu
READING_CONVERT_REMOTE_TMPDIR=/tmp/dsh-reading

# ---------- Obsidian 导出 ----------
READING_OBSIDIAN_EXPORT_DIR=读书笔记

# ---------- URL 抓取 ----------
READING_FETCH_TIMEOUT_MS=20000
# READING_FETCH_USER_AGENT=
