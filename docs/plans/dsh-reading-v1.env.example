# dsh-reading 配置模板 —— 非密钥部分
# 用法：复制为 $DSH_HOME/.env（本机即 ~/.local/dsh_home/.env）
# 密钥（*_PASSWORD / *_SECRET / *_TOKEN）不放在这里，
# 写入 $DSH_HOME/.credentials.yaml 的 refs: 段，键名与变量名相同，例如：
#   refs:
#     DSH_READING_OPDS_0_PASSWORD: "xxxx"
#     DSH_READING_WALLABAG_CLIENT_SECRET: "xxxx"
# 插件解析顺序：进程环境 > credentials refs > $DSH_HOME/.env
# 多主机部署：每台机器各配一份，变量名不变。

# ---------- 数据 ----------
DSH_READING_DATA_DIR=~/.local/dsh_home/reading

# ---------- OPDS 书源（可配置多个，n = 0,1,2...） ----------
# 注意：calibre-web 须直连后端端口（本例 9083），9080 前端的 nginx 会剥掉 Authorization
DSH_READING_OPDS_0_NAME=nasubuntu-calibre
DSH_READING_OPDS_0_URL=http://192.168.88.22:9083/opds
DSH_READING_OPDS_0_AUTH=basic
DSH_READING_OPDS_0_USERNAME=dshreading
# DSH_READING_OPDS_0_PASSWORD  → .credentials.yaml

# ---------- Wallabag（URL 收藏 / 稍后读 / 正文提取） ----------
DSH_READING_WALLABAG_URL=http://192.168.88.22:8292
DSH_READING_WALLABAG_CLIENT_ID=6_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DSH_READING_WALLABAG_CLIENT_SECRET / _USERNAME / _PASSWORD → .credentials.yaml

# ---------- Amazon 格式转换（SSH 到 calibre 主机执行 ebook-convert） ----------
DSH_READING_CONVERT_SSH_TARGET=nasubuntu
DSH_READING_CONVERT_REMOTE_TMPDIR=/tmp/dsh-reading

# ---------- Obsidian 导出 ----------
DSH_READING_OBSIDIAN_EXPORT_DIR=读书笔记

# ---------- URL 抓取 ----------
DSH_READING_FETCH_TIMEOUT_MS=20000
# DSH_READING_FETCH_USER_AGENT=
