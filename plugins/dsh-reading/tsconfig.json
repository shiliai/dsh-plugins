{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "react", "react-dom"],
    "baseUrl": ".",
    "paths": {
      "@dsh-plugins/dsh-reading-core": ["../../packages/dsh-reading-core/src/index.ts"],
      "@dsh-plugins/dsh-config-portability": ["../../packages/dsh-config-portability/src/index.ts"],
      "@dsh-plugins/dsh-config-portability/client": ["../../packages/dsh-config-portability/src/client.tsx"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tsdown.config.ts", "vitest.config.ts"]
}
