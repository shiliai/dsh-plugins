{
  "name": "dsh-hik-view",
  "version": "0.1.1",
  "description": "DSH web plugin: live view of Hikvision NVR cameras. Server half relays RTSP (H.265) to browser-friendly MJPEG through ffmpeg (quality-degradable, same-origin so it traverses the remote relay); client half registers a sidebar tab with channel switching",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiliai/dsh-plugins.git",
    "directory": "plugins/dsh-hik-view"
  },
  "homepage": "https://github.com/shiliai/dsh-plugins/tree/main/plugins/dsh-hik-view#readme",
  "bugs": "https://github.com/shiliai/dsh-plugins/issues",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run build",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6 <0.1.0-rc.9",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6 <0.1.0-rc.9",
    "schemastery": ">=3.18.0",
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "schemastery": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.3.1",
    "schemastery": "^3.18.0",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.2"
  }
}
