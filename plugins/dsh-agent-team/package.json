{
  "name": "@dsh-plugins/dsh-agent-team",
  "version": "0.1.0",
  "description": "Team router for DeepSeek Harness: a global team_delegate tool lets the session model (leader) hand self-contained tasks to cheap worker models, with TypeSafe jev judging complexity and executor, and fail-open fallback to the leader",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiliai/dsh-plugins.git",
    "directory": "plugins/dsh-agent-team"
  },
  "homepage": "https://github.com/shiliai/dsh-plugins/tree/main/plugins/dsh-agent-team#readme",
  "bugs": {
    "url": "https://github.com/shiliai/dsh-plugins/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "pack:check": "pnpm run build && node scripts/verify-pack.mjs",
    "release:check": "pnpm run check && pnpm run pack:check",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
