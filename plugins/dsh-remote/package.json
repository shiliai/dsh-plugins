{
  "name": "@dsh-plugins/dsh-remote",
  "version": "0.2.1",
  "description": "Private remote-access gateway for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiliai/dsh-plugins.git",
    "directory": "plugins/dsh-remote"
  },
  "homepage": "https://github.com/shiliai/dsh-plugins/tree/main/plugins/dsh-remote#readme",
  "bugs": "https://github.com/shiliai/dsh-plugins/issues",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "scripts/",
    "templates/",
    "docs/operations/vps-edge.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "dsh-remote-edge": "./scripts/dsh-remote-edge.mjs",
    "dsh-remote-install-node": "./scripts/install-dsh-remote-instance.sh"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "pack:check": "pnpm run build && node scripts/verify-self-contained-package.mjs && pnpm pack --dry-run",
    "test:hub-admin": "node tests/e2e/run-hub-admin-browser.mjs",
    "e2e:rc6": "node tests/e2e/run-rc6-fixture-e2e.mjs",
    "release:check": "pnpm run check && pnpm run pack:check && pnpm run e2e:rc6",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-directory-picker-browse": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-directory-picker-browse": "0.1.0-rc.6",
    "react": "18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "@deepseek-ai/dsh-client-ui-layout": { "optional": true },
    "@deepseek-ai/dsh-client-ui-sidebar": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-client-ui-directory-picker-browse": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "@deepseek-ai/dsh-host-directory-picker-browse": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@playwright/test": "^1.55.0",
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@types/ws": "^8.5.14",
    "http-proxy": "^1.18.1",
    "lucide-react": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  }
}
